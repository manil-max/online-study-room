<?xml version="1.0" encoding="utf-8"?>
<!-- WP-752 (§2.6): K1/K2 kart zemini - DAR yaricap.

     `widget_card_bg` 20dp yaricap tasir ve 110dp+ kutularda dogrudur. 40x40dp
     bir K1 kutusunda 20dp yaricap koselerin TAMAMINI yer; kart karta degil
     HAPA doner. Bu dosya ayni zemin/kenar dilini 12dp yaricapla verir.

     Secim kodda yapilir: `setInt(rootId, "setBackgroundResource", resId)` -
     `View.setBackgroundResource` `@RemotableViewMethod`tur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_ember_night" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_ember_ash" />
    <corners android:radius="@dimen/widget_design_corner_tight" />
</shape>
