<?xml version="1.0" encoding="utf-8"?>
<!-- Varsayilan 2x1. Kisa kutuda buyuk sayi + kucuk eylem ipucu gorunur;
     tum kart 48dp'den buyuk tek Baslat/Durdur hedefidir. Uzun kutuda ayrica
     48dp tam kontrol satiri ve ders secimi acilir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:minHeight="48dp"
    android:minWidth="48dp"
    android:orientation="vertical"
    android:padding="4dp">

    <Chronometer
        android:id="@+id/timer_widget_elapsed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="00:00"
        android:textColor="@color/widget_design_ink"
        android:textScaleX="0.55"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/timer_widget_compact_action"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_action_bg"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/action_start"
        android:textColor="@color/widget_design_surface"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/timer_widget_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_design_row_gap"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/timer_widget_subject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/widget_design_row_gap"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/widget_design_ink_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/timer_widget_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_action_bg"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/action_start"
            android:textColor="@color/widget_design_surface"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
