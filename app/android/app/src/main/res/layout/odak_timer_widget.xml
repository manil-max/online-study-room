<?xml version="1.0" encoding="utf-8"?>
<!-- WP-718: sayac widget'i - okunur sayi + 48dp dokunma hedefi + ders secimi.

     ## Olculen "once" durumu (WP-134/699 hali)
     Kok dolgu 6dp, sayi `timerTime` merdiveninden 15sp (en dar sinif), dugme
     11sp ve `minHeight=32dp`. Yani sahibin cihazinda gordugu sey gercekten
     15sp'lik bir "00:00" ve 32dp'lik bir "Basla" idi. Android'in kendi widget
     kilavuzunun asgari dokunma hedefi 48dp'dir; 32dp onun ucte ikisi.

     ## Neden dugme ayri bir SATIR degil, ayri bir SURFACE
     48dp'lik bir kontrol + okunur bir sayi 110dp'lik (2 hucre) bir kutuya
     ancak sigar; 40dp'lik (1 hucre) bir kutuya SIGMAZ. Bu yuzden en kisa
     sinifta (`SHORT`) kontrol satiri tamamen kalkar ve **kokun kendisi**
     baslat/durdur olur: 1 hucrelik bir widget launcher'in gercek hucresine
     cizilir (yaygin telefonlarda ~70-85dp), yani tum yuzey >= 48dp'lik tek
     bir hedef olur. Kucuk bir hapi 40dp'ye sikistirmak yerine hedefi
     buyutmenin tek yolu budur.

     ## Gorsel dil
     Renk/zemin simgeleri WP-717'nin paylasilan dilinden gelir
     (`widget_card_bg`, `widget_design_*`). Kok DOLGUSU bilerek o dosyanin
     12dp'lik `widget_design_padding` olcusunu kullanmaz: 110dp'lik bir
     tile'da 12dp'lik cift yan dolgu genisligin %22'sini yer ve sayiyi tam da
     sahibin sikayet ettigi yere geri dusurur. WP-717 rengi ile olcuyu ayri
     simgelerde tuttugu icin bu ayrisma dilin disina cikmaz; dolgu
     `timerRootPaddingDp` icinde boyuta gore surulur.

     Aritmetik `WidgetSizeClassWp699Test.kt` + `TimerWidgetWp718Test.kt`
     icinde yeniden kurulur; punto buyutulur ya da dugme kucultulurse kirmizi
     duser. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <Chronometer
        android:id="@+id/timer_widget_elapsed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="00:00"
        android:textColor="@color/widget_design_accent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Kontrol satiri: SHORT boyutta tamamen GONE olur (yukaridaki gerekce).
         Ders hapi GONE oldugunda LinearLayout onu hic olcmez, yani `weight`
         payi da harcanmaz ve Baslat/Durdur satirin tamamini kaplar. -->
    <LinearLayout
        android:id="@+id/timer_widget_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_design_row_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/timer_widget_subject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/widget_design_row_gap"
            android:layout_weight="1"
            android:background="@drawable/timer_pill_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/widget_design_ink_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/timer_widget_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/timer_pill_bg"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/action_start"
            android:textColor="@color/widget_design_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
