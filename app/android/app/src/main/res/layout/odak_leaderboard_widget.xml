<?xml version="1.0" encoding="utf-8"?>
<!-- WP-756 - Kamp Siralamasi. Sozlesme: `docs/tasarim/widget-tasarim-sistemi.md`.

     CEKIRDEK (§1.4): KULLANICININ KENDI SIRASI - `#3`. Uc karakterlik bir sayi
     cekirdegidir; 1x1'de tek basina kalan sey odur. Sirasi yoksa cekirdek
     GLIFe duser (kupa ikonu) - listenin basi degil, cunku 40x40dp'de bir isim
     okunmaz ve kullanici o widget'i kendi sirasini gormek icin kurdu.

     KADEME (§1.1-1.3). Launcher hucre olcusu 70n-30'dur; yani pratikte yalniz
     40 / 110 / 180 / 250dp kutular olusur:

       K1 (genislik < 110dp)   cekirdek seridi: `#3` (ya da kupa glifi)
       K2 (yukseklik < 110dp)  cekirdek + LIDER satiri - tek satir, YATAY
       K3 (110..149dp)         baslik + iki sira
       K4 (>= 150dp)           baslik + AYRAC + uc sira

     Dusme sirasi SABITtir: once baslik (kullanici widget'i kendi eliyle kurdu,
     hangisi oldugunu bilir), sonra ayrac, sonra liste kuyrugu; cekirdek ASLA
     dusmez.

     🔴 2./3. SIRA ROZET METNI `ink_dim` (6.59:1) - eskiden `accent` (flame,
     8.19:1) idi. Ikisi de WCAG AA'yi (4.5:1) gecer; karar KONTRAST DEGIL
     HIYERARSI gerekcesiyle verildi: `flame` bu ailede "SEN" demektir
     (K1/K2 cekirdegi ve listede kendi satirin). Ikinci ve ucuncu siranin
     rakamlari da flame olsaydi kisisel vurgu bir sinyal olmaktan cikardi -
     deponun "kirmizi rozet kirmizi temada kayboluyor" dersinin ayni sinifi.
     Oran `ListFamilyRedesignWp756Test` icinde YENIDEN hesaplanir, belgeden
     kopyalanmaz.

     🔴 Satirlar STATIKtir: RemoteViews dinamik satir uretemez, kod yalnizca
     `setViewVisibility` ile acip kapatir. Ayrac duz `View` degil 1dp
     `ImageView`dir (§4.4) - RemoteViews'in izin listesinde duz `View` yoktur. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/leaderboard_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/cd_leaderboard_widget"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/leaderboard_widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_card_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- K1/K2 cekirdek seridi. K1'de yalniz `#3` (ya da kupa glifi); K2'de
             yaninda LIDER satiri acilir. Iki metin ve YATAY: K2'de dikey yigma
             yasaktir (36dp ic yukseklikte iki 11sp satir "sigmiyor", "henuz
             tasmiyor"dur; §1.2). -->
        <LinearLayout
            android:id="@+id/leaderboard_widget_core"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|center_horizontal"
            android:minHeight="26dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/leaderboard_widget_core_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_ic_leaderboard"
                android:visibility="gone" />

            <TextView
                android:id="@+id/leaderboard_widget_core_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="@string/widget_dash"
                android:textColor="@color/widget_ember_flame"
                android:textScaleX="0.85"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/leaderboard_widget_core_lead"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_no_records"
                android:textColor="@color/widget_ember_ink_dim"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- K3/K4 baslik: 14dp kupa ikonu + widget adi. Ikon 14dp'dir cunku
             baslik blogunun yuksekligini METIN belirler (13-16sp ~ 17-21dp);
             daha buyuk bir ikon blogu buyutur ve liste bir satir kaybederdi. -->
        <LinearLayout
            android:id="@+id/leaderboard_widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/leaderboard_widget_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_ic_leaderboard" />

            <TextView
                android:id="@+id/leaderboard_widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_leaderboard_title"
                android:textColor="@color/widget_ember_ink_dim"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- §4.4: ayrac YALNIZ K4'te ve YALNIZ baslik ile liste arasinda.
             Satirlarin arasina konmaz; orada ayrimi bosluk yapar. -->
        <ImageView
            android:id="@+id/leaderboard_widget_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_design_divider"
            android:layout_marginTop="3dp"
            android:background="@drawable/widget_divider"
            android:contentDescription="@null"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/leaderboard_widget_row_container_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/leaderboard_widget_rank_1"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_rank_first_bg"
                android:gravity="center"
                android:maxLines="1"
                android:text="1"
                android:textColor="@color/widget_ember_night"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/leaderboard_widget_row_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_no_records"
                android:textColor="@color/widget_ember_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/leaderboard_widget_row_container_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/leaderboard_widget_rank_2"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_rank_other_bg"
                android:gravity="center"
                android:maxLines="1"
                android:text="2"
                android:textColor="@color/widget_ember_ink_dim"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/leaderboard_widget_row_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_dash"
                android:textColor="@color/widget_ember_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/leaderboard_widget_row_container_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/leaderboard_widget_rank_3"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_rank_other_bg"
                android:gravity="center"
                android:maxLines="1"
                android:text="3"
                android:textColor="@color/widget_ember_ink_dim"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/leaderboard_widget_row_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_dash"
                android:textColor="@color/widget_ember_ink"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
