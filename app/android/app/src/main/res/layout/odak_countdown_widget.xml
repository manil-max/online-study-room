<?xml version="1.0" encoding="utf-8"?>
<!-- WP-755: SINAV GERI SAYIMI - "ilerleme" ailesinin ikinci yay tasiyicisi.

     Sozlesme: `docs/tasarim/widget-tasarim-sistemi.md`.

     CEKIRDEK (§1.4): kalan gun. `12` uc karaktere sigar. Sigmayan iki hal
     var ve ikisinde de cekirdek GLIFtir (`countdown_widget_core_glyph`,
     kum saati):
       1) kayit yok / tarih gecti  -> gosterilecek sayi YOKTUR; tire bir sayi
          degil, sayinin yokluguydu ve kahraman puntoda okunmuyordu
       2) 999 gunden uzak sinav    -> dort karakter, K1'e kahraman girmez

     Kademe butcesi (§1.2), asagidan yukari:
       K1 (40x40)     cekirdek                                1 oge, 0 grafik
       K2 (110x40)    cekirdek + "gun kaldi"  (YATAY)         2 oge, 0 grafik
       K3 (110x110)   cekirdek + etiket + sinav adi + yay
                      + yardimci satirlar                     3 oge, 1 grafik
       K4 (110x180+)  baslik + ayrac + yukaridakiler          5 oge, 1 grafik

     🔴 Kahraman blogu WP-755'te DIKEYden YATAYa dondu. Sebep aritmetik:
     110dp'lik bir kutuda ust uste gun + etiket + ad ~70dp yer kapliyordu ve
     geriye yay + uc satir icin yer kalmiyordu (K2'de ise dikey yigma §1.2
     ile zaten yasak). Yatay dizilim ayni bilgiyi ~39dp'de veriyor.

     Satirlar STATIKtir (uc tane): RemoteViews `ListView` disinda dinamik
     satir uretemez. Hangisinin gorunecegini yukseklik sinifi belirler
     (`countdownVisibleRowCount`), yani buyutunce bilgi ARTAR.

     Varsayilan metinler bos durumu cizer: launcher onizlemesi ve ilk
     `onUpdate` bos bir dikdortgen degildir. Yay onizlemede %35 dolu
     baslatilir ki widget seciciye grafik kimligiyle girsin.

     Renkler `widget_ember_*` paletinden gelir; ham hex ve emoji YOKTUR. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:contentDescription="@string/cd_countdown_widget"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/countdown_widget_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/countdown_widget_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_ic_countdown" />

        <TextView
            android:id="@+id/countdown_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_countdown_title"
            android:textColor="@color/widget_ember_ink_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/countdown_widget_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_design_divider"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/widget_divider"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/countdown_widget_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/countdown_widget_core"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/countdown_widget_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="@string/widget_em_dash"
                android:textColor="@color/widget_ember_flame"
                android:textScaleX="0.85"
                android:textSize="30sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/countdown_widget_core_glyph"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/widget_ic_countdown"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/countdown_widget_hero_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/countdown_widget_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_countdown_empty"
                android:textColor="@color/widget_ember_ink_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/countdown_widget_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_countdown_title"
                android:textColor="@color/widget_ember_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/countdown_widget_arc"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_design_arc_height"
        android:layout_marginTop="@dimen/widget_design_row_gap"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="200dp"
        android:minHeight="12dp"
        android:progress="35"
        android:progressDrawable="@drawable/widget_progress_arc" />

    <LinearLayout
        android:id="@+id/countdown_widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_design_row_gap"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/countdown_widget_row_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_ember_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/countdown_widget_row_days_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:textColor="@color/widget_ember_glow"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/countdown_widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_design_row_gap"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/countdown_widget_row_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_ember_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/countdown_widget_row_days_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:textColor="@color/widget_ember_glow"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/countdown_widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_design_row_gap"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/countdown_widget_row_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_ember_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/countdown_widget_row_days_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:textColor="@color/widget_ember_glow"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
