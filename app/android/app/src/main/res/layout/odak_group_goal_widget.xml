<?xml version="1.0" encoding="utf-8"?>
<!-- Yuzde yayin icinde yalniz bir kez yer alir; altinda ikinci bir kopya yoktur. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_goal_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/group_goal_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_group_goal"
        android:textColor="@color/widget_design_ink_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/group_goal_widget_gauge"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="3dp">

        <ProgressBar
            android:id="@+id/group_goal_widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_arc" />

        <TextView
            android:id="@+id/group_goal_widget_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_percent_zero"
            android:textColor="@color/widget_design_ink"
            android:textSize="22sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/group_goal_widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_join_group"
        android:textColor="@color/widget_design_ink_muted"
        android:textSize="12sp" />
</LinearLayout>
