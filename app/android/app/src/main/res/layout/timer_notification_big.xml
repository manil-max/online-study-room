<?xml version="1.0" encoding="utf-8"?>
<!-- WP-793 (sahip, cihazda, v80): "bildirim panelindeki bildirimde kronometre
     MM:SS kucuk kalmis, buyutmek lazim."

     Bu, kosan panelin GENISLETILMIS (big content) gorunumudur. Daraltilmis
     gorunum `timer_notification.xml`de kalir ve tek satirdir; oradaki sayacin
     ust siniri dugmenin 44dp yuksekligidir. Buyuk saat ancak ikinci bir duzenle
     mumkun: genisletilmis bildirimin yukseklik butcesi 256dp'ye kadar cikar.

     Duzen dikeydir ve bu bilincli: saat TEK BASINA bir satirda durur. Yatayda
     56sp "1:23:45" (~220dp) ile 84dp hap ayni satira 320dp ekranda SIGMAZ ve
     `RemoteViews` icinde `autoSizeTextType` yoktur; rakamlar sagdan kirpilir.
     Saat ustte tam genislik, hap altta sagda: hicbir genislikte kirpilma yok.

     🔴 RENK KURALI `timer_notification.xml` ile AYNI ve IKI YONLUDUR:
       1) Golge zemini ustundeki metin (`notif_timer_elapsed`, `notif_timer_label`)
          rengini ASLA sabit yazmaz, bildirim `TextAppearance`ini kullanir.
       2) Kendi cizdigimiz hap (`notif_timer_action`) ustundeki metin rengini
          DAIMA sabit yazar.
     Kimlikler daraltilmis duzenle BIREBIR AYNIDIR; boylece tek baglama kodu
     (`buildRunningRemoteViews`) iki duzeni de doldurur ve biri guncellenip
     oteki unutulamaz. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <Chronometer
        android:id="@+id/notif_timer_elapsed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="00:00:00"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="56sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Faz etiketi yalniz molada dolar (WP-761); odakta bos kalir. -->
        <TextView
            android:id="@+id/notif_timer_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_timer_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/timer_pill_bg"
            android:gravity="center"
            android:minWidth="84dp"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/action_stop"
            android:textColor="@color/timer_notification_action_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
