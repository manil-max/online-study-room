<?xml version="1.0" encoding="utf-8"?>
<!-- WP-701: gorev listesi widget'i. Duzen deseni odak_countdown_widget.xml'den
     alindi: ayni renk kaynaklari (values/ + values-night/ widget_colors.xml),
     ayni tek satirlik ellipsize kurallari.

     Satirlar STATIKTIR (bes tane): RemoteViews `ListView` disinda dinamik
     satir uretemez ve `RemoteViewsService` bu widget icin fazladan bir
     surec/adaptor maliyetidir. Kutuya sigmayan satir GONE olur
     (`taskWidgetRowCapacity`).

     Kutucuk bir CheckBox DEGIL, metin isaretidir: RemoteViews `CheckBox`i
     yalniz API 31+ kabul eder, bu uygulamanin minSdk'si daha eskidir. Isaret
     bir SEMBOLdur (U+2610 / U+2611), cevrilecek bir metin degil; satirin
     yazisi ve baslik Dart tarafindan (l10n) gelir.

     Ilk cizimde ayna henuz yazilmamis olabilir: o durumda satirlar GONE olur
     ve `task_widget_empty` gorunur, yani launcher onizlemesi bos bir
     dikdortgen degildir.

     🔴 WP-719 — IKI KATMAN. Once tek katman vardi ve boyali kok
     `match_parent` idi: kutuya ne kadar yer ayrilirsa ayrilsin kart o kadarini
     boyuyordu, yani "Gorevler / Henuz gorev yok" yazan widget kocaman bos bir
     dikdortgen olarak duruyordu. Simdi:

       task_widget_frame  -> seffaf, kutunun tamami, icerigi DIKEY ORTALAR
       task_widget_root   -> boyali kart, `wrap_content`

     Boylece cizilen kart icerigi kadardir: bos durumda ~44dp, bes gorevde
     ~208dp. Olcum `test/features/android_widgets/task_widget_wp719_test.dart`
     icinde tablo halinde kirmizi duser. Kart artik kutuyu doldurmadigi icin
     kalan seffaf alanin da bir dokunma hedefi olmali; saglayici
     `task_widget_frame`e de gorev ekranini baglar (WP-706 korunur). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical">

<LinearLayout
    android:id="@+id/task_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/task_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_today"
        android:textColor="@color/widget_design_ink_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/task_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_no_records"
        android:textColor="@color/widget_design_ink_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/task_widget_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/task_widget_box_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingEnd="6dp"
            android:text="☐"
            android:textColor="@color/widget_design_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/task_widget_label_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_design_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/task_widget_box_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingEnd="6dp"
            android:text="☐"
            android:textColor="@color/widget_design_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/task_widget_label_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_design_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/task_widget_box_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingEnd="6dp"
            android:text="☐"
            android:textColor="@color/widget_design_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/task_widget_label_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_design_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/task_widget_box_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingEnd="6dp"
            android:text="☐"
            android:textColor="@color/widget_design_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/task_widget_label_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_design_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_widget_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/task_widget_box_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingEnd="6dp"
            android:text="☐"
            android:textColor="@color/widget_design_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/task_widget_label_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_design_ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
</LinearLayout>
