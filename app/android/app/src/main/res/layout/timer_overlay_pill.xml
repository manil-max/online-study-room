<?xml version="1.0" encoding="utf-8"?>
<!-- WP-764: ekranin ustunde yuzen sayac seridi.

     🔴 BU BIR `RemoteViews` DEGILDIR ve fark buyuktur. Bildirim paneli baska
     bir surecte (SystemUI) sisirildigi icin orada ConstraintLayout, ozel View,
     `autoSizeTextType` ve animasyon KULLANILAMIYOR. Bu pencere BIZIM
     surecimizde yasar: normal bir View agacidir, hicbir kisit yoktur.

     WP-775 (sahibin cizimi, onizlemede onaylandi): tek yatay hap, 52dp.
     Solda logo (26dp), ortada buyuk MM:SS (22sp kalin), sagda METINLI hap
     dugme: kosarken beyaz "Durdur", bosta sari "Baslat". Serit durunca
     kaybolmaz. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:background="@drawable/timer_overlay_bg"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- Cipteki logoyla AYNI kaynak: bildirimin kucuk ikonu (kamp atesi
         silueti). -->
    <ImageView
        android:id="@+id/overlay_timer_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_stat_focus_camp"
        android:tint="@color/timer_overlay_ink" />

    <Chronometer
        android:id="@+id/overlay_timer_elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="00:00"
        android:textColor="@color/timer_overlay_ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Tek dugme, iki anlam; metin, zemin ve renk kodda duruma gore
         degisir (TimerOverlay.bindState). 36dp: hapin icinde parmakla
         vurulabilir. -->
    <TextView
        android:id="@+id/overlay_timer_action"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/timer_overlay_action_bg"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="76dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/action_stop"
        android:textColor="@color/timer_overlay_action_ink"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
