<?xml version="1.0" encoding="utf-8"?>
<!-- WP-764: ekranin ustunde yuzen sayac seridi.

     🔴 BU BIR `RemoteViews` DEGILDIR ve fark buyuktur. Bildirim paneli baska
     bir surecte (SystemUI) sisirildigi icin orada ConstraintLayout, ozel View,
     `autoSizeTextType` ve animasyon KULLANILAMIYOR. Bu pencere BIZIM
     surecimizde yasar: normal bir View agacidir, hicbir kisit yoktur.

     WP-774 (sahip, cihazda): serit artik durum cubugundaki Live Update CIPI
     gibi gorunur: solda logo, ortada sayac, sagda KUCUK tek dugme. Eski
     buyuk turuncu dugme "cok buyuk"tu. Serit durunca kaybolmaz: bosta `00:00`
     ve Baslat gosterir; ayni dugme kosarken Durdur olur. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/timer_overlay_bg"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="5dp"
    android:paddingEnd="5dp"
    android:paddingBottom="5dp">

    <!-- Cipteki logoyla AYNI kaynak: bildirimin kucuk ikonu (kamp atesi
         silueti). Iki yuzey ayni simgeyi tasir. -->
    <ImageView
        android:id="@+id/overlay_timer_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_stat_focus_camp"
        android:tint="@color/timer_overlay_ink" />

    <Chronometer
        android:id="@+id/overlay_timer_elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="00:00"
        android:textColor="@color/timer_overlay_ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Tek dugme, iki anlam: kosarken Durdur (kare), bosta Baslat (ucgen).
         Simge ve erisilebilirlik etiketi kodda duruma gore degisir. 32dp:
         cip olcusunde ama parmakla vurulabilir. -->
    <ImageView
        android:id="@+id/overlay_timer_action"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/timer_overlay_action_bg"
        android:contentDescription="@string/action_stop"
        android:padding="8dp"
        android:src="@drawable/ic_overlay_stop" />
</LinearLayout>
