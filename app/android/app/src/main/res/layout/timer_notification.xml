<?xml version="1.0" encoding="utf-8"?>
<!-- Samsung One UI'da doğrulanan tek satır sayaç: solda HH:MM:SS + faz etiketi,
     sağda doğrudan Başlat/Durdur. Sistem aksiyonları kullanılmaz; One UI bunları
     ikinci satırda Break/Stop olarak çizdiği için ürün tasarımını bozuyordu.

     🔴 WP-759 — RENK KURALI IKI YONLUDUR. Kanit: emulator olcumleri,
     `.artifacts/wp759-goruntu/`. Ikisini de bozan bir tur oldu:
       WP-205 ham `#FFFFFF` yazdi  -> ACIK golgede metin kayboldu.
       WP-753 tema niteligi yazdi  -> KOYU golgede dugme kayboldu (1.08:1).

     1) GOLGE ZEMINI ustundeki metin (`notif_timer_elapsed`, `notif_timer_label`)
        rengini ASLA sabit yazmaz ve ASLA `?android:attr/...` kullanmaz.
        Bildirim `TextAppearance`ini kullanir: onun rengi yapilandirmaya bagli
        bir KAYNAKtir (`@color/notification_*_text_color`) ve HOST'un koyu/acik
        ayarini izler. Tema NITELIKLERI izlemez — `RemoteViews` uygulamanin
        `ApplicationInfo` temasiyla (= platformun acik varsayilani) sisirilir.
     2) KENDI cizdigimiz hap (`notif_timer_action`) ustundeki metin rengini
        DAIMA sabit yazar; zemini de biz cizdigimiz icin kontrast olculebilir.

     Bu iki yon `TimerNotificationPanelWp759Test` icinde ayri ayri olculur.

     WP-753: bu panel `timer_panel_expanded=false` yazilmadikca VARSAYILAN
     yoldur (özel görünüm taşıdığı için Live Update terfisi alamaz). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <Chronometer
        android:id="@+id/notif_timer_elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:text="00:00:00"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- 🔴 WP-759 kusur 3: mola ile odak bildirimde AYIRT EDILEMIYORDU. Panelin
         ekran goruntuleri rakam disinda birebir ayniydi ve tek isaret, koyu
         temada zaten gorunmeyen dugme etiketiydi. Faz artik panelin kendisinde
         yazar. Yukseklik ARTMASIN diye ayni satirda durur: daralmis bildirimin
         icerik alani sinirlidir, ikinci satir kirpilma riski tasir. -->
    <TextView
        android:id="@+id/notif_timer_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_timer_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/timer_pill_bg"
        android:gravity="center"
        android:minWidth="84dp"
        android:minHeight="44dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/action_stop"
        android:textColor="@color/timer_notification_action_ink"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
