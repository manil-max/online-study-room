<?xml version="1.0" encoding="utf-8"?>
<!-- WP-718: "minimal sayac" ana ekran widget'i.

     Tek gorunur oge sayidir; tum yuzey Baslat/Durdur'dur. Ayri bir dugme
     YOKTUR ve bu bir eksiklik degil, 48dp kuralinin tek cozumudur: 1-2
     hucrelik bir kutuda 48dp'lik bir hapi ayri cizmek geriye okunur bir sayi
     icin yer birakmaz (olcum `TimerWidgetWp718Test.kt`). Yuzeyin tamami hedef
     olunca hedef, launcher'in gercek hucresi kadar buyuk olur.

     Dolgu 2dp: varsayilan yukseklik 1 hucre (40dp) ve o kutuda dolgunun her
     dp'si dogrudan puntodan dusuyor. Renkler WP-717'nin paylasilan dilinden
     (`widget_card_bg`, `widget_design_ink`, `widget_design_accent`); calisan
     ve duran hali metin RENGIYLE ayrilir, cunku ikinci bir satir eklemek
     widget'i "minimal" olmaktan cikarirdi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/minimal_timer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:minHeight="48dp"
    android:minWidth="48dp"
    android:orientation="vertical"
    android:padding="2dp">

    <Chronometer
        android:id="@+id/minimal_timer_widget_elapsed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="00:00"
        android:textColor="@color/widget_design_ink"
        android:textSize="19sp"
        android:textStyle="bold" />
</LinearLayout>
