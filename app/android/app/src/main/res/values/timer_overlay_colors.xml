<!-- WP-764: yuzen sayac seridinin paleti.

     🔴 Neden tema niteligi DEGIL de sabit hex: serit rastgele bir uygulamanin
     ustunde durur. Altindaki zemini bilmiyoruz ve cihazin koyu/acik ayari
     altindaki uygulamanin cizdigi rengi soylemiyor. Kontrast ancak ZEMINI DE
     BIZ cizersek olculebilir olur.

     Ayni ders bildirim panelinde iki kez ogrenildi: WP-205 ham beyaz yazdi,
     acik golgede kayboldu; WP-753 tema niteligi yazdi, koyu golgede kayboldu.
     Burada o sarkac hic baslamasin diye cift bastan sabit.

     WP-775 (sahibin cizimi, onizlemede onaylandi): zemin cip mavisi, saat ve
     logo beyaz; dugme kosarken BEYAZ hap / mavi yazi, bosta SARI hap / koyu
     yazi (Baslat ile Durdur bir bakista ayrissin). Olculen oranlar:
       ink / fill              = 5.5:1  (beyaz / #2F5BE5)
       action_ink / action_fill = 5.5:1  (#2F5BE5 / beyaz)
       idle_ink / idle_fill     = 11.9:1 (#1A1F33 / #FFD166) -->
<resources>
    <!-- Seridin OPAK zemini: cip mavisi. -->
    <color name="timer_overlay_fill">#2F5BE5</color>
    <!-- Logo ve sayac rakamlari. -->
    <color name="timer_overlay_ink">#FFFFFF</color>
    <!-- Kosarken dugme: beyaz hap, mavi yazi. -->
    <color name="timer_overlay_action_fill">#FFFFFF</color>
    <color name="timer_overlay_action_ink">#2F5BE5</color>
    <!-- Bosta dugme: sari hap, koyu yazi. -->
    <color name="timer_overlay_action_idle_fill">#FFD166</color>
    <color name="timer_overlay_action_idle_ink">#1A1F33</color>
</resources>
