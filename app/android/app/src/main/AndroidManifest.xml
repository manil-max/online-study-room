<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- APK indirmek için internet erişimi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ kalıcı sayaç bildirimi için kullanıcı izni gerekir. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WP-110: REQUEST_INSTALL_PACKAGES main'de YOK.
         Yalnız GitHub sideload source set (stable/beta) ekler; play flavor almaz. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 14+: uzun süre görünür kalan kullanıcı başlatmalı sayaç için.
         dataSync Android 15'te 24 saatte 6 saatle sınırlıdır; 8 saatlik sayaç
         sözleşmesi için bu servis specialUse olarak bildirilir. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- WP-58: Alarm 2.0 — kesin (exact) alarm. Saat merkezi ürünü için gerekli. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Saat P1: pil optimizasyonu muafiyeti iste (OEM kill engeli) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- WP-559: per-app locale. `localeConfig` olmadan Android 13+
         `LocaleManager.setApplicationLocales` cagrisini yok sayar; native
         bildirim/widget/alarm metinleri uygulamada secilen dili degil CIHAZ
         dilini kullanir (telefon TR + uygulama EN -> bildirim "Durdur"). -->
    <application
        android:label="${appName}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:localeConfig="@xml/locales_config">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="announcements" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
              android:name="android.app.shortcuts"
              android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep Links for Supabase Auth Recovery -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- 
                  Flavor'a özel callback scheme beta/stable auth oturumlarını
                  aynı telefonda birbirinden ayırır. Her scheme ilgili Supabase
                  projesinin Authentication -> URL Configuration listesine eklenir.
                -->
                <data android:scheme="${authCallbackScheme}" android:host="login-callback" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- WP-118: exported=false — yalnız aynı uygulamanın PendingIntent'i tetikler. -->
        <receiver
            android:name=".widgets.TimerActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.manilmax.online_study_room.ACTION_TOGGLE_TIMER" />
            </intent-filter>
        </receiver>
        <!-- WP-42/51: Sayacın native foreground servisi. Widget/bildirim Başlat-Durdur
             uygulama kapalıyken de bunu ayağa kaldırır; oturum kaydı app açılışında
             Dart tarafında yapılır.
             WP-103: API 29–33 kodu DATA_SYNC, API 34+ SPECIAL_USE kullanır; tip
             manifest alt kümesi olmalı → dataSync|specialUse (yalnız specialUse
             iken ≤13 IllegalArgumentException / RemoteServiceException çökmesi). -->
        <service
            android:name=".timer.StudyTimerService"
            android:foregroundServiceType="dataSync|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started study stopwatch and break timer with persistent notification controls." />
        </service>
        <receiver
            android:name=".TimerBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Saat P0: native exact alarm receiver + full-screen ring -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_CHANGED" />
                <action android:name="com.manilmax.online_study_room.ACTION_FIRE_ALARM" />
                <action android:name="com.manilmax.online_study_room.ACTION_FIRE_TIMER" />
                <action android:name="com.manilmax.online_study_room.ACTION_ALARM_DISMISS" />
                <action android:name="com.manilmax.online_study_room.ACTION_ALARM_SNOOZE" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".alarm.AlarmRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <receiver
            android:name=".widgets.TimerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odak_timer_widget_info" />
        </receiver>
        <!-- WP-695: sinav geri sayimi. Yayinda (enabled bayragi yok);
             katalogdaki `published: true` ile ayni tarafta durmali.
             Ayrisirsa countdown_widget_wp695_test kirmizi duser. -->
        <receiver
            android:name=".widgets.CountdownWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_countdown">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odak_countdown_widget_info" />
        </receiver>
        <!-- WP-461: Yayinda yalniz 1x1 Baslat/Durdur widget'i var.
             Asagidaki bes saglayici SILINMEDI; revizyon icin kodu, layout'u
             ve xml tanimi repoda duruyor. `enabled="false"` bileseni
             picker'dan ve sistemden dusurur; geri acmak tek nitelik. -->
        <receiver
            android:name=".widgets.StudyStatsWidgetProvider"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odak_stats_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.GroupGoalWidgetProvider"
            android:enabled="false"
            android:exported="true"
            android:label="@string/widget_label_group_goal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odak_group_goal_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.GroupLeaderboardWidgetProvider"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odak_leaderboard_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.ClockWidgetProvider"
            android:enabled="false"
            android:exported="true"
            android:label="@string/widget_label_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odak_clock_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.AlarmWidgetProvider"
            android:enabled="false"
            android:exported="true"
            android:label="@string/widget_label_next_alarm">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odak_alarm_widget_info" />
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
